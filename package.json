{
  "name": "dsh-jev-verify",
  "version": "0.7.5",
  "description": "Jev (TypeSafe System One decision model) for DeepSeek Harness — five verdict tools: jev_decision (up to 25 typed questions in one parallel call, measured median 266-484 ms), jev_choose (rank 2-10 approaches), jev_overview (session ledger), jev_guard_status (auto-guard audit), jev_verify (frozen 27-question live benchmark run 6-way parallel, 4.96 s wall, 96.3% measured). Plus an automatic tool-call guard (10 deterministic rules in two tiers - 7 hard-block, 3 Jev-judged - plus a Jev risk/loop backstop), system-prompt guidance so the agent actually calls it, and a GUI settings card. Honest by design: no API key means an explicit error, never fabricated results; every registration is quarantined so a failure degrades one feature, never the profile.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cases": {
      "types": "./lib/types/cases.d.ts",
      "default": "./lib/cases.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "bench",
    "docs",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xienda/dsh-jev-verify.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "jev",
    "typesafe",
    "system-one",
    "decision-model",
    "verification",
    "benchmark",
    "classifier",
    "guardrails"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-credentials": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "scripts": {
    "bench": "node bench/bench.mjs",
    "check": "node --check lib/index.js && node --check lib/cases.js && node --check bench/bench.mjs && node --check lib/guard.js && node --check lib/dashboard.js && node --check client/client.js",
    "test": "node --test \"test/*.test.mjs\"",
    "test:functional": "node test/functional.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "homepage": "https://github.com/xienda/dsh-jev-verify",
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  }
}
